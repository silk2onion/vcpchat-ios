default_platform(:ios)

platform :ios do
  desc "Build an unsigned device .ipa. Re-sign it with AltStore or Sideloadly."
  lane :unsigned do
    sh("bash", "../scripts/build-unsigned-ipa.sh")
  end

  desc "Build the iOS Simulator .app."
  lane :simulator do
    sh("bash", "../scripts/build-ios-simulator.sh")
  end
end
