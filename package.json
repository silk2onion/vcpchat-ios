{
  "name": "vcpchat-ios",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "description": "iOS-ready VCPChat client for a self-hosted VCPToolBox server",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43123 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview --host 0.0.0.0 --port 43123 --strictPort",
    "tauri": "tauri",
    "icon": "node scripts/make-icon.mjs && tauri icon src-tauri/app-icon.png -o src-tauri/icons",
    "mock-server": "node scripts/mock-vcp.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^16.4.0",
    "mermaid": "^12.2.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tauri-apps/cli": "2.12.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.5.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^20.0.2",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.0"
  }
}
